[Unit]
Description=Prepare SusanOS persistent data directories
RequiresMountsFor=/sudoagi/data
Before=containerd.service docker.service miniforge3-install.service mender-authd.service mender-updated.service mender-client.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/sudoagi-data-init
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
