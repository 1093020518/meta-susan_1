#!/bin/sh
set -eu

DATA_ROOT="/sudoagi/data"
MENDER_SEED="/usr/share/susan/data-seed/mender"
TOOLS_SEED="/usr/share/sys-tools/data-seed"
TOOLS_ROOT="${DATA_ROOT}/tools"
TOOLS_MARKER="${DATA_ROOT}/.sys-tools-seeded-v1"

install_tool() {
    archive="$1"
    directory="$2"
    staging="${TOOLS_ROOT}/.${directory}.installing"

    [ -f "$archive" ] || return 1
    [ ! -e "${TOOLS_ROOT}/${directory}" ] || return 0

    rm -rf "$staging"
    mkdir -p "$staging"
    tar -xzf "$archive" -C "$staging"
    [ -d "${staging}/${directory}" ] || return 1
    mv "${staging}/${directory}" "${TOOLS_ROOT}/${directory}"
    rmdir "$staging"
}

if ! grep -qs " ${DATA_ROOT} " /proc/mounts; then
    echo "sudoagi-data-init: ${DATA_ROOT} is not mounted" >&2
    exit 1
fi

mkdir -p "${DATA_ROOT}/home"
chmod 0755 "${DATA_ROOT}/home"

mkdir -p "${DATA_ROOT}/containerd"
chown root:root "${DATA_ROOT}/containerd"
chmod 0711 "${DATA_ROOT}/containerd"

mkdir -p "${DATA_ROOT}/workspace"
chown root:susan-admins "${DATA_ROOT}/workspace"
chmod 2775 "${DATA_ROOT}/workspace"

mkdir -p "${DATA_ROOT}/mender"
chmod 0700 "${DATA_ROOT}/mender"

if [ -d "${MENDER_SEED}" ]; then
    for src in "${MENDER_SEED}"/*; do
        [ -e "$src" ] || continue

        name="${src##*/}"

        if [ ! -e "${DATA_ROOT}/mender/${name}" ]; then
            cp -a "$src" "${DATA_ROOT}/mender/"
        fi
    done
fi

if [ ! -e "${TOOLS_MARKER}" ]; then
    mkdir -p "${TOOLS_ROOT}"

    if install_tool \
        "${TOOLS_SEED}/sys-profiling-service.tar.gz" \
        "sys-profiling-service" && \
       install_tool \
        "${TOOLS_SEED}/sys-log-bundle-20260825.tgz" \
        "sys-log-bundle"; then
        chown -R root:susan-admins "${TOOLS_ROOT}"

        mkdir -p \
            "${TOOLS_ROOT}/sys-profiling-service/data/csv" \
            "${TOOLS_ROOT}/sys-profiling-service/data/plots"
        chown -R root:susan-admins \
            "${TOOLS_ROOT}/sys-profiling-service/data"
        chmod 2775 \
            "${TOOLS_ROOT}/sys-profiling-service/data" \
            "${TOOLS_ROOT}/sys-profiling-service/data/csv" \
            "${TOOLS_ROOT}/sys-profiling-service/data/plots"

        touch "${TOOLS_MARKER}"
    else
        echo "sudoagi-data-init: failed to seed system tools" >&2
    fi
fi

exit 0
