[Unit]
Description=Initialize SudoAGI private persistent configuration
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target systemd-networkd.service sshd.service dropbear.service mender-authd.service mender-updated.service mender-client.service
Wants=network-pre.target
ConditionPathIsMountPoint=/sudoagi/private

[Service]
Type=oneshot
ExecStart=/usr/sbin/sudoagi-persistent-config
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
