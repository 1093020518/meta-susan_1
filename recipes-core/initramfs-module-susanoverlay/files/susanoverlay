#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin

susanoverlay_enabled() {
    [ "${bootparam_sudoagi_overlay:-}" = "1" ] || [ "${bootparam_sudoagi_overlay:-}" = "true" ]
}

susanoverlay_finish_without_overlay() {
    echo "$1" >/dev/console
    echo "Susan overlayroot failed, continuing with read-only rootfs" >/dev/console
    . /init.d/99-finish
    eval "finish_run"
}

susanoverlay_run() {
    oldroot="${ROOTFS_DIR:-/rootfs}"
    overlay_dev="${bootparam_sudoagi_overlay_dev:-/dev/nvme0n1p7}"
    data_mount="/sudoagi-data"
    lower_mount="/sudoagi-lower"
    newroot="/sudoagi-newroot"

    case "${bootparam_root:-}" in
        *p4|*rootfs_a*|*p5|*rootfs_b*)
            ;;
        *)
            susanoverlay_finish_without_overlay \
                "Cannot determine active rootfs from root=${bootparam_root:-}"
            ;;
    esac

    mkdir -p "$data_mount"

    count=0
    while [ ! -e "$overlay_dev" ] && [ "$count" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    mount -n -t ext4 -o rw "$overlay_dev" "$data_mount" || \
        susanoverlay_finish_without_overlay \
            "Cannot mount data/overlay device $overlay_dev"

    # Directories required before systemd processes /etc/fstab.
    mkdir -p "$data_mount/home"
    chmod 0755 "$data_mount/home"

    upper_dir="$data_mount/upper"
    work_dir="$data_mount/workdir"

    mkdir -p "$upper_dir" "$work_dir" "$lower_mount" "$newroot"

    mount -n -o bind "$oldroot" "$lower_mount" || \
        susanoverlay_finish_without_overlay "Cannot bind active rootfs"
    mount -n -o remount,ro "$lower_mount" || \
        susanoverlay_finish_without_overlay "Cannot remount active rootfs read-only"

    mount -n -t overlay overlay \
        -o lowerdir="$lower_mount",upperdir="$upper_dir",workdir="$work_dir" \
        "$newroot" || \
        susanoverlay_finish_without_overlay "Cannot mount overlay rootfs"

    mkdir -p \
        "$newroot/proc" \
        "$newroot/sys" \
        "$newroot/dev" \
        "$newroot/rofs" \
        "$newroot/sudoagi/data" \
        "$newroot/sudoagi/private"

    mount -n --move "$lower_mount" "$newroot/rofs"
    mount -n --move "$data_mount" "$newroot/sudoagi/data"
    mount -n --move /proc "$newroot/proc"
    mount -n --move /sys "$newroot/sys"
    mount -n --move /dev "$newroot/dev"

    exec chroot "$newroot" "${bootparam_init:-/sbin/init}" || \
        susanoverlay_finish_without_overlay "Cannot enter overlay rootfs"
}
