# 447.1 GiB validation NVMe layout.
# p1 Reserved
part --ondisk nvme0n1 --size 1 --align 1024 --part-name reserved

# p2 EFI
part /boot/efi --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.bootimg" --ondisk nvme0n1 --fstype=vfat --label efi --part-name efi --align 1024 --fixed-size 512M --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B --no-fstab-update

# p3 Recovery
part --source rawcopy --sourceparams="file=susan-recovery-image-genericx86-64.ext4" --ondisk nvme0n1 --part-name recovery --align 1024 --fixed-size 2048M --part-type=0FC63DAF-8483-4772-8E79-3D69D8477DE4

# p4 RootFS A
part / --source rootfs --ondisk nvme0n1 --fstype=ext4 --label rootfs_a --part-name rootfs_a --align 1024 --fixed-size 65536M --part-type=0FC63DAF-8483-4772-8E79-3D69D8477DE4

# p5 RootFS B, pre-populated for first-flash validation.
part --source rootfs --ondisk nvme0n1 --fstype=ext4 --label rootfs_b --part-name rootfs_b --align 1024 --fixed-size 65536M --part-type=0FC63DAF-8483-4772-8E79-3D69D8477DE4

# p6 Log
part /var/log --ondisk nvme0n1 --fstype=ext4 --label log --part-name log --align 1024 --fixed-size 32768M --part-type=0FC63DAF-8483-4772-8E79-3D69D8477DE4 --no-fstab-update

# p7 Data. Shared business data and Overlay upper/work.
part /sudoagi/data --ondisk nvme0n1 --fstype=ext4 --label data --part-name data --align 1024 --fixed-size 204800M --part-type=0FC63DAF-8483-4772-8E79-3D69D8477DE4 --no-fstab-update

# p8 Private
part /sudoagi/private --ondisk nvme0n1 --fstype=ext4 --label private --part-name private --align 1024 --fixed-size 46000M --part-type=0FC63DAF-8483-4772-8E79-3D69D8477DE4 --no-fstab-update

bootloader --ptable gpt --timeout=5 --append="rootfstype=ext4 ro rootwait sudoagi_overlay=1 sudoagi_overlay_dev=/dev/nvme0n1p7 console=ttyS0,115200 console=tty0"
